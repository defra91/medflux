{% macro render_statistics_charts(s) %}
  {% for chart in s.charts %}
    <div class="chart-container">
      <h4>{{ chart.title }}</h4>

      {% if chart.description %}
        <p>{{ chart.description }}</p>
      {% endif %}

      {% if chart.image_url %}
        <div class="img-container">
          <img class="img-fluid" src="{{ chart.image_url }}" alt="{{ chart.title }}">
        </div>
      {% endif %}
    </div>
  {% endfor %}

{% endmacro %}
